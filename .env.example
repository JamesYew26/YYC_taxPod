# Copy to .env and fill in. Never commit .env.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-side only (ingestion script + Next.js API routes). Bypasses RLS — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Google AI Studio → Get API key (free tier, no credit card)
GEMINI_API_KEY=...
# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
# RAG_TOP_K=5
# RAG_MIN_SIMILARITY=0.80
